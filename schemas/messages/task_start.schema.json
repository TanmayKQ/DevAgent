{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devagent.dev/schemas/messages/task_start.schema.json",
  "title": "task_start payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "repo_root", "max_iterations"],
  "properties": {
    "task": { "type": "string", "minLength": 1 },
    "repo_root": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path, for the reasoning loop's context only — the harness independently enforces the repo-root jail on every tool call and never trusts this value for that purpose."
    },
    "max_iterations": { "type": "integer", "minimum": 1 },
    "model": { "type": "string", "minLength": 1 }
  }
}
